<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style type="text/css">
    /* Header */
    .header {
      text-align: center;
    }
    .btn-primary {
      display: block;
      margin: auto;
      background-color: #FF0000;
      color: #fff;
      padding: 10px 20px;
      border-radius: 3px;
      font-size: 14px;
      text-align: center;
      text-decoration: none;
      font-weight: bold;
      width: auto;
      max-width: 200px;
    }
    /* Logo */
    .header img.logo {
      height: 30px;
      width: auto;
      margin-bottom: 20px;
    }
    /* Body */
    body {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif,
        'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';
      background-color: #F5F5F5;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      color: #373737;
      width: 100%;
    }
    .container {
      width: calc(100% - 40px);
      max-width: 600px;
      margin: 40px auto;
      background: #ffffff;
      padding: 20px;
      box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
      border-radius: 5px;
    }
    a {
      color: #E7212D;
    }
    p {
      color: #373737;
      font-size: 16px;
      line-height: 1.8;
      text-align: left;
      margin: 0;
      white-space: pre-line;
    }
    p.sub {
      color: #373737;
      font-size: 14px;
      line-height: 2;
    }

    /* Title with icon before it */
    .section-title {
      font-size: 20px;
      font-weight: bold;
      color: #333;
      margin-bottom: 10px;
      position: relative;
      display: flex;
      align-items: center;
    }
    /* Table */
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
    }
    .table th, .table td {
      padding: 10px 14px;
      border: 1px solid #eeeeee;
      text-align: left;
      font-size: 14px;
    }
    .table th {
      width: 30%;
      background-color: #f5f7fa;
      margin: 0;
      color: #333333;
      line-height: 1.8;
      font-weight: normal;
    }
    .table td {
      width: 70%;
    }
    .table a {
      color: #d9534f;
      text-decoration: none;
    }

    .table a:hover {
      text-decoration: underline;
    }
    /* Footer */
    .footer {
      margin: 0 auto;
      text-align: center;
      padding: 0;
      width: 640px;
    }
    .footer p {
      color: #b0adc5;
      font-size: 14px;
      text-align: center;
    }
    hr {
      height: 1px;
      background-color: #eeeeee;
      border: none;
      color: #eeeeee;
      margin: 20px 0;
    }
    .br {
      margin-top: 10px;
      margin-bottom: 10px;
    }
  </style>
</head>
