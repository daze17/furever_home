{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "modules/email/templates/**/*",
        "watchAssets": true,
        "outDir": "dist"
      }
    ],
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": true
  }
}
