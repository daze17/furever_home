    "customer_api": "workspace:*",
    "database": "workspace:*",
    "date-fns": "^4.1.0",
    "devalue": "^5.1.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.3.2",
    "ioredis": "^5.8.2",
    "jose": "^6.0.10",
    "nestjs-cls": "^5.4.3",
    "nestjs-i18n": "^10.5.1",
