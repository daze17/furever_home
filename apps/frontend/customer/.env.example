# Server-side environment variables
SESSION_SECRET=your-secret-key-here

# Client-side environment variables (NEXT_PUBLIC_ prefix makes them available in the browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_GOOGLE_LOGIN_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_REGISTER_REDIRECT_URL=http://localhost:3000/api/auth/google/register/callback
